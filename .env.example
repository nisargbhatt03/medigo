# ===================================================
# Health-Flow-System — Local Environment Variables
# ===================================================
# Copy this file to .env and fill in your values.
# Get a free PostgreSQL DB from: https://neon.tech
# ===================================================

# PostgreSQL connection string (from Neon / Supabase / etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Ports (optional — defaults: frontend=5173, backend=3000)
# PORT=5173

# API server port (used when running api-server manually)
# API_PORT=3000
